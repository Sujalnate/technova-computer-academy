<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Courses | TechNova Computer Academy</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <script defer src="/js/main.js"></script>
</head>
<body>
  <div class="topbar">
    <div class="container topbar-inner">
      <div>Welcome to TechNova Computer Academy</div>
      <div class="topbar-links">
        <a href="tel:+919876543210">📞 <%= site.phone %></a>
        <a href="mailto:<%= site.email %>">✉️ <%= site.email %></a>
      </div>
    </div>
  </div>
  <header class="header">
    <div class="container navbar">
      <div class="logo-wrap">
        <div class="logo-mark">TN</div>
        <div class="logo-text"><strong><%= site.name %></strong><small><%= site.tagline %></small></div>
      </div>
      <nav>
        <ul class="main-nav">
          <li><a href="/">Home</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/courses">Courses</a></li>
          <li><a href="/admissions">Admissions</a></li>
          <li><a href="/faculty">Faculty</a></li>
          <li><a href="/facilities">Facilities</a></li>
          <li><a href="/blog">Blog</a></li>
          <li><a href="/faq">FAQ</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>
      <div class="nav-actions"><a class="btn btn-secondary" href="tel:+919876543210">Call Us</a> <button class="btn btn-primary" data-open-callback>Get a Callback</button></div>
    </div>
  </header>
  <div class="page-header"><div class="container"><span class="badge">Courses</span><h1>Explore our learning pathways</h1><div class="breadcrumbs"><a href="/">Home</a> / <span>Courses</span></div></div></div>
  <main class="section">
    <div class="container">
      <div class="filter-bar">
        <div class="search-box">
          <input id="courseSearch" placeholder="Search courses..." />
        </div>
        <div class="filter-tags">
          <button class="active" data-filter="all">All</button>
          <% categories.forEach(category => { %>
            <button data-filter="<%= category %>"><%= category %></button>
          <% }); %>
        </div>
      </div>
      <div class="course-grid">
        <% courses.forEach(course => { %>
          <article class="course-card" data-category="<%= course.category %>" data-name="<%= course.name %>">
            <div class="card-image"><img src="<%= course.image %>" alt="<%= course.name %>" /></div>
            <div class="card-body">
              <div class="card-meta"><span class="tag"><%= course.category %></span><span><%= course.duration %></span></div>
              <h3><%= course.name %></h3>
              <p><%= course.shortDescription %></p>
              <ul class="card-list">
                <% course.highlights.slice(0,3).forEach(item => { %><li><%= item %></li><% }); %>
              </ul>
              <div class="card-actions"><span><strong><%= site.currency %> Contact</strong></span><a class="link-primary" href="/courses/<%= course.slug %>">View Details</a></div>
            </div>
          </article>
        <% }); %>
      </div>
      <div id="courseEmptyState" class="empty-state" style="display:none; margin-top:2rem;">No courses match your search. Try another keyword or clear the filters.</div>
    </div>
  </main>
  <footer class="footer"><div class="container footer-grid"><div><h3>TechNova</h3><p>Learn Today. Build Tomorrow.</p></div><div><h3>Links</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="/about">About</a></li><li><a href="/courses">Courses</a></li><li><a href="/contact">Contact</a></li></ul></div><div><h3>Support</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="/faq">FAQ</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy-policy">Privacy</a></li></ul></div><div><h3>Contact</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="tel:+919876543210"><%= site.phone %></a></li><li><a href="mailto:<%= site.email %>"><%= site.email %></a></li></ul></div></div></footer>
  <div class="modal" id="callbackModal"><div class="modal-card"><button class="modal-close" id="closeCallbackModal">×</button><h2>Request a callback</h2><form data-form-type="callback"><div class="form-grid"><div class="form-group"><label>Full Name</label><input name="name" required/></div><div class="form-group"><label>Mobile</label><input name="phone" required/></div><div class="form-group"><label>Email</label><input name="email" type="email" /></div><div class="form-group"><label>Course</label><select name="course"><option value="">Select course</option><option>Basic Computer</option><option>MS Office</option><option>Web Development</option></select></div><div class="form-group"><label>Preferred Time</label><select name="preferredTime"><option>Morning</option><option>Afternoon</option><option>Evening</option></select></div><div class="form-group full"><label>Message</label><textarea name="message" rows="4"></textarea></div></div><div class="hero-actions"><button class="btn btn-primary" type="submit">Submit</button></div><div class="form-message" aria-live="polite"></div></form></div></div>
</body>
</html>
