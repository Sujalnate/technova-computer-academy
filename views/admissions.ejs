<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admissions | TechNova Computer Academy</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <script defer src="/js/main.js"></script>
</head>
<body>
  <header class="header">
    <div class="container navbar">
      <div class="logo-wrap"><div class="logo-mark">TN</div><div class="logo-text"><strong><%= site.name %></strong><small><%= site.tagline %></small></div></div>
      <nav><ul class="main-nav"><li><a href="/">Home</a></li><li><a href="/about">About</a></li><li><a href="/courses">Courses</a></li><li><a href="/admissions">Admissions</a></li><li><a href="/faculty">Faculty</a></li><li><a href="/facilities">Facilities</a></li><li><a href="/blog">Blog</a></li><li><a href="/faq">FAQ</a></li><li><a href="/contact">Contact</a></li></ul></nav>
      <div class="nav-actions"><a class="btn btn-secondary" href="tel:+919876543210">Call Us</a> <button class="btn btn-primary" data-open-callback>Get a Callback</button></div>
    </div>
  </header>
  <div class="page-header">
    <div class="container">
      <span class="badge">Admissions</span>
      <h1>Start your learning journey with TechNova</h1>
      <div class="breadcrumbs"><a href="/">Home</a> / <span>Admissions</span></div>
    </div>
  </div>
  <main class="section">
    <div class="container">
      <div class="feature-grid">
        <article class="feature-card">
          <div class="feature-icon">1</div>
          <h3>Choose Your Course</h3>
          <p>Explore beginner-friendly, professional, and job-oriented courses based on your interests and goals.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">2</div>
          <h3>Discuss Batch Options</h3>
          <p>Ask about timings, batch slots, and suitable start dates for your preferred learning schedule.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">3</div>
          <h3>Submit Enquiry</h3>
          <p>Share your details, course interest, and questions to get a quick response from the team.</p>
        </article>
        <article class="feature-card">
          <div class="feature-icon">4</div>
          <h3>Enroll and Start</h3>
          <p>Complete the formal process and begin classes with practical guidance from the trainers.</p>
        </article>
      </div>

      <div class="section" style="padding-top:2rem;">
        <div class="form-shell">
          <h2 class="section-title">Admission enquiry form</h2>
          <form data-form-type="general">
            <div class="form-grid">
              <div class="form-group"><label>Student Name</label><input name="name" required /></div>
              <div class="form-group"><label>Phone Number</label><input name="phone" required /></div>
              <div class="form-group"><label>Email</label><input name="email" type="email" /></div>
              <div class="form-group"><label>Interested Course</label><select name="course"><option value="">Select course</option><option>Basic Computer</option><option>MS Office</option><option>Advanced Excel</option><option>Tally, Accounting and GST</option><option>C Programming</option><option>C++</option><option>Java</option><option>Python</option><option>Web Development</option><option>Graphic Design and DTP</option><option>Computer Hardware and Networking</option></select></div>
              <div class="form-group"><label>Preferred Batch Time</label><select name="preferredTime"><option>Morning</option><option>Afternoon</option><option>Evening</option><option>Flexible</option></select></div>
              <div class="form-group full"><label>Message</label><textarea name="message" rows="5" required></textarea></div>
            </div>
            <div class="hero-actions"><button class="btn btn-primary" type="submit">Submit Enquiry</button></div>
            <div class="form-message" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </main>
  <footer class="footer"><div class="container footer-grid"><div><h3>TechNova</h3><p>Learn Today. Build Tomorrow.</p></div><div><h3>Quick Links</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="/courses">Courses</a></li><li><a href="/faq">FAQ</a></li><li><a href="/contact">Contact</a></li></ul></div><div><h3>Support</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="/privacy-policy">Privacy</a></li><li><a href="/terms">Terms</a></li></ul></div><div><h3>Contact</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="tel:+919876543210"><%= site.phone %></a></li><li><a href="mailto:<%= site.email %>"><%= site.email %></a></li></ul></div></div></footer>
</body>
</html>
