<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Contact Us | TechNova Computer Academy</title>
  <link rel="stylesheet" href="/css/styles.css" />
  <script defer src="/js/main.js"></script>
</head>
<body>
  <header class="header"><div class="container navbar"><div class="logo-wrap"><div class="logo-mark">TN</div><div class="logo-text"><strong><%= site.name %></strong><small><%= site.tagline %></small></div></div><nav><ul class="main-nav"><li><a href="/">Home</a></li><li><a href="/about">About</a></li><li><a href="/courses">Courses</a></li><li><a href="/admissions">Admissions</a></li><li><a href="/faculty">Faculty</a></li><li><a href="/facilities">Facilities</a></li><li><a href="/blog">Blog</a></li><li><a href="/faq">FAQ</a></li><li><a href="/contact">Contact</a></li></ul></nav><div class="nav-actions"><a class="btn btn-secondary" href="tel:+919876543210">Call Us</a> <button class="btn btn-primary" data-open-callback>Get a Callback</button></div></div></header>
  <div class="page-header"><div class="container"><span class="badge">Contact</span><h1>Let’s discuss the right course for you</h1><div class="breadcrumbs"><a href="/">Home</a> / <span>Contact</span></div></div></div>
  <main class="section">
    <div class="container">
      <div class="about-grid">
        <div class="callout-box">
          <h3>Contact information</h3>
          <p><strong>Address:</strong> <%= site.address %></p>
          <p><strong>Phone:</strong> <a href="tel:+919876543210"><%= site.phone %></a></p>
          <p><strong>Email:</strong> <a href="mailto:<%= site.email %>"><%= site.email %></a></p>
          <p><strong>Hours:</strong> <%= site.hours %></p>
          <p><strong>WhatsApp:</strong> <a href="https://wa.me/919876543210?text=Hello%20TechNova%20Computer%20Academy%2C%20I%20want%20to%20know%20more%20about%20your%20courses." target="_blank">Chat on WhatsApp</a></p>
          <p><a href="<%= site.mapsUrl %>" target="_blank" class="link-primary">Open Google Maps</a></p>
        </div>
        <div class="form-shell">
          <h2 class="section-title">Send us a message</h2>
          <form data-form-type="general">
            <div class="form-grid">
              <div class="form-group"><label>Name</label><input name="name" required /></div>
              <div class="form-group"><label>Phone</label><input name="phone" required /></div>
              <div class="form-group"><label>Email</label><input name="email" type="email" /></div>
              <div class="form-group"><label>Course</label><select name="course"><option value="">Select course</option><option>Basic Computer</option><option>MS Office</option><option>Advanced Excel</option><option>Tally, Accounting and GST</option><option>C Programming</option><option>C++</option><option>Java</option><option>Python</option><option>Web Development</option><option>Graphic Design and DTP</option><option>Computer Hardware and Networking</option></select></div>
              <div class="form-group full"><label>Message</label><textarea name="message" rows="5" required></textarea></div>
            </div>
            <div class="hero-actions"><button class="btn btn-primary" type="submit">Send Message</button></div>
            <div class="form-message" aria-live="polite"></div>
          </form>
        </div>
      </div>
    </div>
  </main>
  <footer class="footer"><div class="container footer-grid"><div><h3>TechNova</h3><p>Learn Today. Build Tomorrow.</p></div><div><h3>Links</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="/about">About</a></li><li><a href="/courses">Courses</a></li><li><a href="/contact">Contact</a></li></ul></div><div><h3>Support</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="/faq">FAQ</a></li><li><a href="/terms">Terms</a></li><li><a href="/privacy-policy">Privacy</a></li></ul></div><div><h3>Contact</h3><ul style="list-style:none; padding:0; margin:0; display:grid; gap:0.7rem;"><li><a href="tel:+919876543210"><%= site.phone %></a></li><li><a href="mailto:<%= site.email %>"><%= site.email %></a></li></ul></div></div></footer>
</body>
</html>
